+* Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA 02111-1307, USA.
+*/
+
+#include "stdinc.h"
+
+#include <api/AdlSearchApi.h>
+
+#include <web-server/JsonUtil.h>
+
+#include <airdcpp/settings/SettingsManager.h>
+#include <airdcpp/util/text/StringMatch.h>
+
+#define MAX_SEARCHES 1000
+#define MAX_TEXT_LENGTH 4096
+// Large enough for any file, and small enough to be multiplied with the size unit
+#define MAX_SIZE_VALUE 1000000000
+
+namespace webserver {
+	static const StringList sourceTypes = { "file", "directory", "full_path" };
+	static const StringList sizeUnits = { "B", "KiB", "MiB", "GiB" };
+
+	AdlSearchApi::AdlSearchApi(Session* aSession) : ApiModule(aSession) {
+		METHOD_HANDLER(Access::SETTINGS_VIEW,	METHOD_GET,		(EXACT_PARAM("searches")),	AdlSearchApi::handleGetSearches);
+		METHOD_HANDLER(Access::SETTINGS_EDIT,	METHOD_POST,	(EXACT_PARAM("searches")),	AdlSearchApi::handleSetSearches);
+		METHOD_HANDLER(Access::SETTINGS_EDIT,	METHOD_POST,	(EXACT_PARAM("reload")),	AdlSearchApi::handleReload);
+		METHOD_HANDLER(Access::SETTINGS_EDIT,	METHOD_POST,	(EXACT_PARAM("settings")),	AdlSearchApi::handleSetSettings);
+		METHOD_HANDLER(Access::SETTINGS_VIEW,	METHOD_POST,	(EXACT_PARAM("test")),		AdlSearchApi::handleTest);
+	}
+
+	json AdlSearchApi::serializeSearch(ADLSearch& aSearch) noexcept {
+		return {
+			{ "pattern", aSearch.getPattern() },
+			{ "regex", aSearch.isRegEx() },
+			{ "source_type", sourceTypes[aSearch.sourceType] },
+			{ "destination", aSearch.getDestDir() },
+			{ "min_size", aSearch.minFileSize },
+			{ "max_size", aSearch.maxFileSize },
+			{ "size_unit", sizeUnits[aSearch.typeFileSize] },
+			{ "comment", aSearch.adlsComment },
+			{ "active", aSearch.isActive },
+			{ "download", aSearch.isAutoQueue },
+		};
+	}
+
+	json AdlSearchApi::serializeAll() noexcept {
+		uint64_t revision = 0;
+		auto searches = ADLSearchManager::getInstance()->getSearches(revision);
+
+		auto items = json::array();
+		for (auto& s: searches) {
+			items.push_back(serializeSearch(s));
+		}
+
+		return {
+			{ "revision", revision },
+			{ "searches", items },
+			{ "settings", {
+				{ "match_full_lists", SETTING(USE_ADLS) },
+				{ "break_on_first", SETTING(ADLS_BREAK_ON_FIRST) },
+			} },
+		};
+	}
+
+	bool AdlSearchApi::isValidRegex(const string& aPattern) noexcept {
+		StringMatch match(false);
+		match.pattern = aPattern;
+		match.setMethod(StringMatch::REGEX);
+		return match.prepare();
+	}
+
+	ADLSearch AdlSearchApi::deserializeSearch(const json& aJson, const string& aFieldName) {
+		auto pattern = JsonUtil::getField<string>("pattern", aJson, false);
+		auto regex = JsonUtil::getOptionalFieldDefault<bool>("regex", aJson, false);
+		auto destination = JsonUtil::getOptionalFieldDefault<string>("destination", aJson, Util::emptyString);
+		auto comment = JsonUtil::getOptionalFieldDefault<string>("comment", aJson, Util::emptyString);
+
+		if (pattern.size() > MAX_TEXT_LENGTH || destination.size() > MAX_TEXT_LENGTH || comment.size() > MAX_TEXT_LENGTH) {
+			JsonUtil::throwError(aFieldName, JsonException::ERROR_INVALID, "The text is too long");
+		}
+
+		// A search without any word would match everything
+		if (pattern.find_first_not_of(" \t\r\n") == string::npos) {
+			JsonUtil::throwError(aFieldName, JsonException::ERROR_INVALID, "The search string is empty");
+		}
+
+		if (regex && !isValidRegex(pattern)) {
+			JsonUtil::throwError(aFieldName, JsonException::ERROR_INVALID, "Invalid regular expression: " + pattern);
+		}
+
+		// The name of a result folder
+		if (destination.find_first_of("/\\") != string::npos) {
+			JsonUtil::throwError(aFieldName, JsonException::ERROR_INVALID, "The destination can't contain / or \\");
+		}
+
+		const auto indexOf = [&](const StringList& aValues, const string& aKey) {
+			auto value = JsonUtil::getOptionalFieldDefault<string>(aKey, aJson, aValues.front());
+			auto i = ranges::find(aValues, value);
+			if (i == aValues.end()) {
+				JsonUtil::throwError(aFieldName, JsonException::ERROR_INVALID, "Invalid value for " + aKey);
+			}
+
+			return static_cast<int>(distance(aValues.begin(), i));
+		};
+
+		const auto size = [&](const string& aKey) {
+			auto value = JsonUtil::getOptionalFieldDefault<int64_t>(aKey, aJson, -1);
+			if (value < -1 || value > MAX_SIZE_VALUE) {
+				JsonUtil::throwError(aFieldName, JsonException::ERROR_INVALID, "Invalid value for " + aKey);
+			}
+
+			return value;
+		};
+
+		ADLSearch search;
+		search.setRegEx(regex);
+		search.setPattern(pattern);
+		search.setDestDir(destination);
+		search.adlsComment = comment;
+		search.sourceType = static_cast<ADLSearch::SourceType>(indexOf(sourceTypes, "source_type"));
+		search.typeFileSize = static_cast<ADLSearch::SizeType>(indexOf(sizeUnits, "size_unit"));
+		search.minFileSize = size("min_size");
+		search.maxFileSize = size("max_size");
+		search.isActive = JsonUtil::getOptionalFieldDefault<bool>("active", aJson, true);
+		search.isAutoQueue = JsonUtil::getOptionalFieldDefault<bool>("download", aJson, false);
+		return search;
+	}
+
+	api_return AdlSearchApi::handleGetSearches(ApiRequest& aRequest) {
+		aRequest.setResponseBody(serializeAll());
+		return http::status::ok;
+	}
+
+	api_return AdlSearchApi::handleSetSearches(ApiRequest& aRequest) {
+		const auto& reqJson = aRequest.getRequestBody();
+		const auto revision = JsonUtil::getField<uint64_t>("revision", reqJson);
+		const auto& items = JsonUtil::getArrayField("searches", reqJson, true);
+		if (items.size() > MAX_SEARCHES) {
+			JsonUtil::throwError("searches", JsonException::ERROR_INVALID, "Too many searches");
+		}
+
+		ADLSearchManager::SearchCollection searches;
+		if (items.is_array()) {
+			for (const auto& item: items) {
+				searches.push_back(deserializeSearch(item, "searches"));
+			}
+		}
+
+		switch (ADLSearchManager::getInstance()->setSearches(std::move(searches), revision)) {
+			case ADLSearchManager::SetResult::OK: break;
+			case ADLSearchManager::SetResult::CONFLICT: {
+				aRequest.setResponseErrorStr("The searches have been changed elsewhere");
+				return http::status::conflict;
+			}
+			case ADLSearchManager::SetResult::SAVE_FAILED: {
+				aRequest.setResponseErrorStr("Saving the searches failed (see the system log)");
+				return http::status::internal_server_error;
+			}
+		}
+
+		aRequest.setResponseBody(serializeAll());
+		return http::status::ok;
+	}
+
+	api_return AdlSearchApi::handleReload(ApiRequest& aRequest) {
+		ADLSearchManager::getInstance()->load();
+		aRequest.setResponseBody(serializeAll());
+		return http::status::ok;
+	}
+
+	api_return AdlSearchApi::handleSetSettings(ApiRequest& aRequest) {
+		const auto& reqJson = aRequest.getRequestBody();
+		auto matchFullLists = JsonUtil::getOptionalField<bool>("match_full_lists", reqJson);
+		auto breakOnFirst = JsonUtil::getOptionalField<bool>("break_on_first", reqJson);
+
+		auto settings = SettingsManager::getInstance();
+		if (matchFullLists) {
+			settings->set(SettingsManager::USE_ADLS, *matchFullLists);
+		}
+
+		if (breakOnFirst) {
+			settings->set(SettingsManager::ADLS_BREAK_ON_FIRST, *breakOnFirst);
+		}
+
+		settings->save();
+
+		aRequest.setResponseBody(serializeAll());
+		return http::status::ok;
+	}
+
+	// Tests a search string against a name, with the same matching as ADLSearch
+	api_return AdlSearchApi::handleTest(ApiRequest& aRequest) {
+		const auto& reqJson = aRequest.getRequestBody();
+		auto pattern = JsonUtil::getField<string>("pattern", reqJson, false);
+		auto text = JsonUtil::getField<string>("text", reqJson, true);
+		auto regex = JsonUtil::getOptionalFieldDefault<bool>("regex", reqJson, false);
+		if (pattern.size() > MAX_TEXT_LENGTH || text.size() > MAX_TEXT_LENGTH) {
+			JsonUtil::throwError("pattern", JsonException::ERROR_INVALID, "The text is too long");
+		}
+
+		if (regex && !isValidRegex(pattern)) {
+			JsonUtil::throwError("pattern", JsonException::ERROR_INVALID, "Invalid regular expression");
+		}
+
+		auto match = StringMatch::getSearch(pattern, regex ? StringMatch::REGEX : StringMatch::PARTIAL);
+		aRequest.setResponseBody({
+			{ "match", match.match(text) },
+		});
+		return http::status::ok;
+	}
+}
