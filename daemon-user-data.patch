+++ b/airdcpp-webapi/web-server/WebUserDataStore.h
@@ -0,0 +1,67 @@
+/*
+* This program is free software; you can redistribute it and/or modify
+* it under the terms of the GNU General Public License as published by
+* the Free Software Foundation; either version 3 of the License, or
+* (at your option) any later version.
+*/
+
+#ifndef DCPLUSPLUS_WEBSERVER_WEBUSERDATASTORE_H
+#define DCPLUSPLUS_WEBSERVER_WEBUSERDATASTORE_H
+
+#include "forward.h"
+
+#include <airdcpp/core/Speaker.h>
+#include <airdcpp/core/thread/CriticalSection.h>
+
+namespace webserver {
+	class WebUserDataStoreListener {
+	public:
+		virtual ~WebUserDataStoreListener() { }
+		template<int I>	struct X { enum { TYPE = I }; };
+
+		typedef X<0> Changed;
+
+		// The revision is 0 if the value was removed
+		virtual void on(Changed, const string& /*aUserName*/, const string& /*aKey*/, int64_t /*aRevision*/) noexcept { }
+	};
+
+	// Small pieces of data that web user interfaces want to keep for each user, so that they are the same on all
+	// devices of the user. The content is not interpreted. Saved in WebUserData.json of the configuration directory.
+	class WebUserDataStore : public Speaker<WebUserDataStoreListener> {
+	public:
+		static constexpr size_t MAX_KEY_LENGTH = 64;
+		static constexpr size_t MAX_VALUE_SIZE = 256 * 1024;
+		static constexpr size_t MAX_KEYS_PER_USER = 200;
+		static constexpr int MAX_DEPTH = 32;
+
+		enum class Result { OK, CONFLICT, TOO_LARGE, TOO_DEEP, TOO_MANY_KEYS, SAVE_FAILED };
+
+		static WebUserDataStore& getInstance() noexcept;
+
+		// {"revision": <number>, "value": <data>}; the revision is 0 and the value null if there is nothing stored
+		json get(const string& aUserName, const string& aKey) noexcept;
+
+		// Stores the value if aRevision is the current revision (so that changes made elsewhere aren't overwritten).
+		// revision_ receives the new revision.
+		Result set(const string& aUserName, const string& aKey, const json& aValue, int64_t aRevision, int64_t& revision_) noexcept;
+
+		void remove(const string& aUserName, const string& aKey) noexcept;
+		void removeUser(const string& aUserName) noexcept;
+
+		WebUserDataStore(WebUserDataStore&) = delete;
+		WebUserDataStore& operator=(WebUserDataStore&) = delete;
+	private:
+		WebUserDataStore() = default;
+
+		void loadUnsafe() noexcept;
+		bool saveUnsafe() const noexcept;
+
+		CriticalSection cs;
+		bool loaded = false;
+
+		// User name -> key -> {"revision", "value"}
+		json users = json::object();
+	};
+}
+
+#endif
