diff --git a/airdcpp-webapi/web-server/WebUserDataStore.cpp b/airdcpp-webapi/web-server/WebUserDataStore.cpp
new file mode 100644
index 00000000..214b6058
--- /dev/null
+++ b/airdcpp-webapi/web-server/WebUserDataStore.cpp
@@ -0,0 +1,157 @@
+/*
+* This program is free software; you can redistribute it and/or modify
+* it under the terms of the GNU General Public License as published by
+* the Free Software Foundation; either version 3 of the License, or
+* (at your option) any later version.
+*/
+
+#include "stdinc.h"
+#include <web-server/WebUserDataStore.h>
+
+#include <web-server/WebServerSettings.h>
+
+#include <airdcpp/events/LogManager.h>
+#include <airdcpp/util/AppUtil.h>
+
+#include <chrono>
+
+#define CONFIG_DIR AppUtil::PATH_USER_CONFIG
+#define CONFIG_NAME "WebUserData.json"
+#define CONFIG_VERSION 1
+
+namespace webserver {
+	static void logError(const string& aError) noexcept {
+		LogManager::getInstance()->message(aError, LogMessage::SEV_ERROR, "Web server");
+	}
+
+	// Serializing is recursive, so very deeply nested data must be refused before it's processed further
+	static bool isTooDeep(const json& aValue, int aDepth) noexcept {
+		if (!aValue.is_structured()) {
+			return false;
+		}
+
+		if (aDepth >= WebUserDataStore::MAX_DEPTH) {
+			return true;
+		}
+
+		return std::any_of(aValue.begin(), aValue.end(), [aDepth](const json& aChild) {
+			return isTooDeep(aChild, aDepth + 1);
+		});
+	}
+
+	WebUserDataStore& WebUserDataStore::getInstance() noexcept {
+		static WebUserDataStore instance;
+		return instance;
+	}
+
+	void WebUserDataStore::loadUnsafe() noexcept {
+		if (loaded) {
+			return;
+		}
+
+		loaded = true;
+		WebServerSettings::loadSettingFile(CONFIG_DIR, CONFIG_NAME, [this](const json& aJson, int) {
+			const auto& data = aJson.at("users");
+			if (data.is_object()) {
+				users = data;
+			}
+		}, logError, CONFIG_VERSION);
+	}
+
+	bool WebUserDataStore::saveUnsafe() const noexcept {
+		try {
+			return WebServerSettings::saveSettingFile({ { "users", users } }, CONFIG_DIR, CONFIG_NAME, logError, CONFIG_VERSION);
+		} catch (const std::exception& e) {
+			logError(e.what());
+			return false;
+		}
+	}
+
+	json WebUserDataStore::get(const string& aUserName, const string& aKey) noexcept {
+		Lock l(cs);
+		loadUnsafe();
+
+		auto user = users.find(aUserName);
+		if (user != users.end()) {
+			auto item = user->find(aKey);
+			if (item != user->end()) {
+				return *item;
+			}
+		}
+
+		return { { "revision", 0 }, { "value", nullptr } };
+	}
+
+	WebUserDataStore::Result WebUserDataStore::set(const string& aUserName, const string& aKey, const json& aValue, int64_t aRevision, int64_t& revision_) noexcept {
+		if (isTooDeep(aValue, 0)) {
+			return Result::TOO_DEEP;
+		}
+
+		if (aValue.dump().size() > MAX_VALUE_SIZE) {
+			return Result::TOO_LARGE;
+		}
+
+		{
+			Lock l(cs);
+			loadUnsafe();
+
+			const auto previous = users;
+			auto& user = users[aUserName];
+			if (!user.is_object()) {
+				user = json::object();
+			}
+
+			auto item = user.find(aKey);
+			const int64_t current = item == user.end() ? 0 : item->value("revision", int64_t(0));
+			if (current != aRevision) {
+				users = previous;
+				return Result::CONFLICT;
+			}
+
+			if (item == user.end() && user.size() >= MAX_KEYS_PER_USER) {
+				users = previous;
+				return Result::TOO_MANY_KEYS;
+			}
+
+			// Based on the time, so that a revision number isn't used again after the file has been removed
+			const auto now = static_cast<int64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+				std::chrono::system_clock::now().time_since_epoch()
+			).count());
+			revision_ = std::max(now, current + 1);
+
+			user[aKey] = { { "revision", revision_ }, { "value", aValue } };
+			if (!saveUnsafe()) {
+				users = previous;
+				return Result::SAVE_FAILED;
+			}
+		}
+
+		fire(WebUserDataStoreListener::Changed(), aUserName, aKey, revision_);
+		return Result::OK;
+	}
+
+	void WebUserDataStore::remove(const string& aUserName, const string& aKey) noexcept {
+		{
+			Lock l(cs);
+			loadUnsafe();
+
+			auto user = users.find(aUserName);
+			if (user == users.end() || !user->erase(aKey)) {
+				return;
+			}
+
+			saveUnsafe();
+		}
+
+		fire(WebUserDataStoreListener::Changed(), aUserName, aKey, int64_t(0));
+	}
+
+	void WebUserDataStore::removeUser(const string& aUserName) noexcept {
+		Lock l(cs);
+		loadUnsafe();
+
+		if (users.erase(aUserName)) {
+			saveUnsafe();
+		}
+	}
+}
