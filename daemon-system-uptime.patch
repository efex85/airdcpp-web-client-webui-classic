+	time_t SystemUtil::getSystemStartTime() noexcept {
+#ifdef __linux__
+		// The file starts with the uptime in seconds, e.g. "12345.67 23456.78"
+		std::ifstream file("/proc/uptime");
+		file.imbue(std::locale::classic());
+
+		long long uptime = 0;
+		if (file >> uptime && uptime > 0) {
+			return time(nullptr) - static_cast<time_t>(uptime);
+		}
+#endif
+		return 0;
+	}
+
